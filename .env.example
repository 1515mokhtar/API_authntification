# JWT
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=15m

# Encryption (if used by your app)
ENCRYPTION_KEY=your-base64-encryption-key
ENCRYPTION_IV=your-16-char-iv

# Server (local dev only; Vercel sets PORT automatically)
PORT=3000

# Email (SMTP)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-app-password
EMAIL_FROM="Auth API" <your-email@example.com>

# Frontend URL for password reset / verification links
FRONTEND_URL=https://your-frontend.example.com

# Firebase — use ONE of the following:
# Local dev: path to service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Vercel / serverless: full service account JSON as a single-line string
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
